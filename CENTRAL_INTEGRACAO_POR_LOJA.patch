+equal(
+  (await db.query("select count(*)::int as n from public.master_store_integration_instructions"))
+    .rows[0].n,
+  0,
+);
+await denied(insert);
+await db.exec(`reset role;select set_config('test.subject','${m}',false);set role authenticated;`);
+equal(
