+export type IntegrationAddon = {
+  id: string;
+  code: string;
+  name: string;
+  description: string;
+  summary: string;
+  compatible_site_types: string[];
+  activation_location: string;
+  suggested_route: string | null;
+  integration_requirements: string;
+  activation_rules: string;
+  disable_rules: string;
+  development_status: string;
+  is_active: boolean;
+};
+export type IntegrationRequest = {
+  id: string;
+  store_id: string;
+  addon_id: string;
+  status: string;
+  commercial_confirmed_at: string | null;
+};
+export type IntegrationAssignment = {
+  id: string;
+  store_id: string;
+  addon_id: string;
+  status: string;
+};
+export type IntegrationInstallation = {
+  id: string;
+  store_id: string;
+  addon_id: string;
+  technical_status: string;
+  installed_version: string | null;
+  last_checkin_at: string;
+};
+export type IntegrationContract = {
+  id: string;
+  store_id: string;
+  plan_code: string | null;
+  status: string;
+  activated_at: string | null;
+  notes: string | null;
+};
+export type IntegrationSnapshot = {
+  stores: IntegrationStore[];
+  addons: IntegrationAddon[];
+  requests: IntegrationRequest[];
+  assignments: IntegrationAssignment[];
+  installations: IntegrationInstallation[];
+  contracts: IntegrationContract[];
+  terms: CompetenceTerms[];
+  competence: string;
+  sources: { addons: boolean; contracts: boolean; terms: boolean };
+  issues: string[];
+};
+const text = z.string();
+const nullable = text
+  .nullable()
+  .optional()
+  .transform((value) => value ?? null);
+const storeSchema = z.object({
+  id: text.uuid(),
+  nx_id: text.min(1),
+  name: text.min(1),
+  plan_code: nullable,
+  status: text,
+  site_type: nullable,
+  plan_started_at: nullable,
+  domains: z
+    .array(z.object({ domain: text }))
+    .optional()
+    .default([]),
+  integrations: z
+    .array(
+      z.object({ provider: text, status: text, last_seen_at: nullable, last_error_code: nullable }),
+    )
+    .optional()
+    .default([]),
+});
+const addonSchema = z.object({
+  id: text.uuid(),
+  code: text.min(1),
+  name: text.min(1),
+  description: text,
+  summary: text,
+  compatible_site_types: z.array(text),
+  activation_location: text,
+  suggested_route: nullable,
+  integration_requirements: text,
+  activation_rules: text,
+  disable_rules: text,
+  development_status: text,
+  is_active: z.boolean(),
+});
+const requestSchema = z.object({
+  id: text.uuid(),
+  store_id: text.uuid(),
+  addon_id: text.uuid(),
+  status: text,
+  commercial_confirmed_at: nullable,
+});
+const assignmentSchema = z.object({
+  id: text.uuid(),
+  store_id: text.uuid(),
+  addon_id: text.uuid(),
+  status: text,
+});
+const installationSchema = z.object({
+  id: text.uuid(),
+  store_id: text.uuid(),
+  addon_id: text.uuid(),
+  technical_status: text,
+  installed_version: nullable,
+  last_checkin_at: text,
+});
+const contractSchema = z.object({
+  id: text.uuid(),
+  store_id: text.uuid(),
+  plan_code: nullable,
+  status: text,
+  activated_at: nullable,
+  notes: nullable,
