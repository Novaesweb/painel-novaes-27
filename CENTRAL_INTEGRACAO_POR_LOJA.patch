+    .replace(/\b(?:sb_secret_|sk_live_|sk_test_)[A-Za-z0-9_-]+/g, "[SEGREDO OMITIDO]")
+    .replace(/\beyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\b/g, "[TOKEN OMITIDO]")
+    .replace(
+      /((?:service_role|senha|password|access_token|api_key)\s*[:=]\s*)\S+/gi,
+      "$1[SEGREDO OMITIDO]",
+    );
+}
